### 2. assembler: M command
TX 'BF 1400 1440 0'     -> BF 1400 1440 0
   PHYSICAL ADDRESS=00001400 00001440
   
   TUTOR  1.3 >
..................................................................
TX 'M 1400'             -> M 1400
   001400    00 ?
..................................................................
    >> 'NOP'              -> b'NOP\r\nERROR \r\n\r\nTUTOR  1.3 > '
    >> 'MOVEQ #5,D0'      -> b'MOVEQ #5,D0\r\nWHAT\r\n\r\nTUTOR  1.3 > '
    >> 'MOVE.B #60,D1'    -> b'MOVE.B #60,D1\r\nWHAT\r\n\r\nTUTOR  1.3 > '
    >> 'LOOP: SUBQ #1,D1' -> b'LOOP: SUBQ #1,D1\r\n'
    >> 'BNE LOOP'         -> b''
    >> 'RTS'              -> b''
TX 'MD 1400'            -> MD 1400
   001400    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  ................
   
   TUTOR  1.3 >
..................................................................
TX 'MD 1420'            -> MD 1420
   001420    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  ................
   
   TUTOR  1.3 >
..................................................................
